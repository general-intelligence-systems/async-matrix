#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_DIR="$(dirname "$(dirname "$BOT_DIR")")"

cd "$PROJECT_DIR"

BIND="${APPSERVICE_BIND:-http://0.0.0.0:9292}"
export APPSERVICE_CONFIG="${APPSERVICE_CONFIG:-$BOT_DIR/config/appservice.yml}"

echo "Starting Echo Bot..."
echo "  Config: $APPSERVICE_CONFIG"
echo "  Bind:   $BIND"
echo ""

exec bundle exec falcon serve --bind "$BIND" --config "$BOT_DIR/config.ru"
