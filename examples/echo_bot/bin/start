#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$BOT_DIR"

BIND="${APPSERVICE_BIND:-http://0.0.0.0:9292}"

echo "Starting Echo Bot..."
echo "  Bind: $BIND"
echo ""

exec bundle exec falcon serve --bind "$BIND" --config config.ru
