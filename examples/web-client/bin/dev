#!/usr/bin/env bash

# DEV(1)                             General Commands Manual                          DEV(1)
#
# NAME
#      bin/dev — run the app and the asset server together
#
# SYNOPSIS
#      bin/dev [process ...]
#
# DESCRIPTION
#      Starts every process in Procfile.dev under overmind, in the foreground, and stops them
#      all on Ctrl-C.
#
#      There are two, and the app needs both: `web` is the server out of server.rb, and `vite` is
#      the asset server the page's script tags point at. Running `web` alone serves a page whose
#      assets 404.
#
#      The sync loop is not a process. server.rb runs it beside the accept loop in the same
#      reactor, so `web` is what fills the session database the pages read.
#
#      Overmind's default is wanted here and --any-can-die is not: a dev server which has
#      quietly crashed while the other one carries on looks like the app is up and
#      misbehaving, rather than down. One dying stops both.
#
#      Naming processes runs only those, which is how to take one of them over: `bin/dev vite`
#      in one terminal and `bin/serve` in another, under whatever debugger wanted.
#
# FILES
#      Procfile.dev
#              The processes, one per line.
#
#      .env
#              Overmind loads this into every process. Not in git, because the encryption key
#              lives here.
#
# ENVIRONMENT
#      MATRIX_SESSION
#              Which session database under sessions/ to open. See config/sequel.rb.
#
#      MATRIX_SYNC_TIMEOUT
#              How long the homeserver holds a sync poll open, in milliseconds. 30000 when unset.
#
#      PORT
#              The port `web` serves on, 9292 by default, which is also ratalada's. Overmind's own
#              base is 5000, so it is set here rather than left to it.
#
#      MATRIX_ENCRYPTION_KEY
#              The Sequel :column_encryption key for Credential's token columns, which must be
#              exactly 32 bytes. Minted into .env when absent.
#
# EXAMPLES
#      Both processes:
#
#            bin/dev
#
#      The asset server only, to run the app under a debugger beside it:
#
#            bin/dev vite
#
# SEE ALSO
#      overmind(1), bin/serve, bin/vite, lib/matrix/sync.rb
#
# async-matrix                          October 13, 2026                              DEV(1)

set -o errexit
set -o nounset

cd "$(dirname "$0")/.."

if ! grep -q '^MATRIX_ENCRYPTION_KEY=' .env 2>/dev/null; then
	printf 'MATRIX_ENCRYPTION_KEY=%s\n' "$(ruby -rsecurerandom -e 'print SecureRandom.alphanumeric(32)')" >>.env
	echo "bin/dev: minted MATRIX_ENCRYPTION_KEY into .env" >&2
fi

exec overmind start -D --procfile Procfile.dev --port "${PORT:-9292}" "$@"
