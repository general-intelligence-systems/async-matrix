#!/usr/bin/env bash

# SERVE(1)                           General Commands Manual                        SERVE(1)
#
# NAME
#      bin/serve — run the app
#
# SYNOPSIS
#      bin/serve
#
# DESCRIPTION
#      Runs server.rb under Falcon, in the foreground.
#
#      This serves the pages and nothing else: the script tags in the HTML shell point at the
#      asset server, which is bin/vite. Use bin/dev to run both.
#
#      Booting connects to a session database and creates the matrix_* tables if they are
#      missing, which config/sequel.rb does on the way in.
#
# ENVIRONMENT
#      MATRIX_SESSION
#              Which session database under sessions/ to open, "default" when unset.
#
#      MATRIX_SESSIONS
#              The directory those databases live in, "sessions" when unset.
#
#      DATABASE_URL
#              Overrides both, with a Sequel connection string.
#
#      RUBY_FIBER_VM_STACK_SIZE, RUBY_FIBER_MACHINE_STACK_SIZE
#              Set here before the VM starts, because the router is one Sinatra app per route
#              file chained as middleware and an unmatched request walks the whole chain. Ruby's
#              defaults (128K and 256K) run out part way down a tree this size, which surfaces
#              as SystemStackError on the deeper routes rather than as a 404. Export either to
#              override.
#
# SEE ALSO
#      bin/dev, bin/vite, config/sequel.rb
#
# async-matrix                          October 12, 2026                            SERVE(1)

set -o errexit
set -o nounset

cd "$(dirname "$0")/.."

export RUBY_FIBER_VM_STACK_SIZE="${RUBY_FIBER_VM_STACK_SIZE:-2097152}"
export RUBY_FIBER_MACHINE_STACK_SIZE="${RUBY_FIBER_MACHINE_STACK_SIZE:-16777216}"

exec bundle exec ruby server.rb
