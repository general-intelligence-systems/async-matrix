git add -N .
export BUNDLE_FORCE_RUBY_PLATFORM=true
export BUNDLE_FROZEN=false

# Relock BEFORE `use flake`, with the plain nixpkgs bundler: inside the
# devshell `bundle` is the bundlerEnv wrapper, which pins BUNDLE_GEMFILE to a
# read-only store copy and re-sets BUNDLE_FROZEN=1 in its own body, so it can
# never relock this tree. bundix -l alone is not enough either -- it only runs
# `bundle lock` when the Gemfile is newer than the lockfile, and a version bump
# touches lib/async/matrix/version.rb, which it never looks at.
nix run nixpkgs#bundler -- lock
nix run nixpkgs#bundix -- -l

use flake
