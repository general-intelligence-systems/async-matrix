#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates MATRIX_EVENTS.md from the YAML schemas and examples fetched
# from the matrix-org/matrix-spec repo, using an ERB template.
#
# Usage: bin/generate-matrix-events-doc
#
# Prerequisites: run bin/fetch-matrix-schemas first

require "yaml"
require "json"
require "erb"
require "pathname"

ROOT = Pathname.new(File.expand_path("..", __dir__))
SCHEMA_DIR = ROOT / "data" / "matrix-spec" / "event-schemas" / "schema"
EXAMPLE_DIR = ROOT / "data" / "matrix-spec" / "event-schemas" / "examples"
SHARED_DIR = ROOT / "data" / "matrix-spec" / "event-schemas"
TEMPLATE = ROOT / "guides" / "matrix-events" / "README.md.erb"
OUTPUT = ROOT / "guides" / "matrix-events" / "README.md"

unless SCHEMA_DIR.exist?
  warn "Schema directory not found. Run bin/fetch-matrix-schemas first."
  exit 1
end

# ── Helpers ─────────────────────────────────────────────────────────

def load_schema(path)
  # All spec files are valid YAML (even the JSON-formatted ones, since
  # JSON is a YAML subset). Try YAML first; fall back to lenient JSON.
  YAML.safe_load(path.read, permitted_classes: [Symbol], aliases: true) || {}
rescue Psych::SyntaxError
  # Some spec files use trailing commas or bare booleans which break
  # YAML parsing. Fall back to cleaning up and re-parsing.
  content = path.read
    .gsub(/,(\s*[}\]])/, '\1')   # strip trailing commas
    .gsub(/:\s*boolean\b/, ': "boolean"') # quote bare boolean type refs
  YAML.safe_load(content, permitted_classes: [Symbol], aliases: true) || {}
rescue => e
  warn "Failed to load #{path}: #{e.message}"
  {}
end

def load_example(file_stem)
  yaml_path = EXAMPLE_DIR / "#{file_stem}.yaml"
  json_path = EXAMPLE_DIR / "#{file_stem}.json"

  path = yaml_path.exist? ? yaml_path : (json_path.exist? ? json_path : nil)
  return nil unless path

  data = load_schema(path)
  data.delete("$ref") # meta-reference to core event JSON, not real data
  data
end

# ── Detect base event kind from allOf.$ref ──────────────────────────

def collect_refs(schema)
  refs = []
  (schema["allOf"] || []).each do |entry|
    refs << entry["$ref"] if entry["$ref"]
  end
  # Also check content.allOf for call_event mixin
  content = schema.dig("properties", "content") || {}
  (content["allOf"] || []).each do |entry|
    refs << entry["$ref"] if entry["$ref"]
  end
  refs
end

def detect_base_kind(refs)
  has_state = refs.any? { |r| r.include?("state_event") }
  has_room = refs.any? { |r| r.include?("room_event") }
  has_call = refs.any? { |r| r.include?("call_event") }

  return :state if has_state
  return :call if has_call
  return :room if has_room
  :basic # event.yaml only, or no ref at all
end

# ── Derive group label from event type prefix + base kind ───────────
#
# Display labels for known prefixes. This is purely cosmetic -- if a
# prefix isn't listed here, the script derives a label automatically
# from the prefix itself (e.g. "m.foo" => "Foo Events").

GROUP_LABELS = {
  "m.call" => "VoIP Events",
  "m.space" => "Space Events",
  "m.policy.rule" => "Moderation Policy Events",
  "m.key.verification" => "Key Verification Events",
}.freeze

# Sort priority for groups (lower = earlier in output).
# Unlisted groups sort alphabetically after these.
GROUP_ORDER = %w[
  Room\ State\ Events
  Room\ Message\ Events
  Ephemeral\ Events
  Space\ Events
  VoIP\ Events
  Moderation\ Policy\ Events
  Account\ Data\ &\ Other\ Events
  Key\ Verification\ Events
  E2E\ &\ Key\ Management\ Events
].freeze

def derive_group(event_type, base_kind)
  # Check known prefixes (longest match first)
  GROUP_LABELS.keys.sort_by { |k| -k.length }.each do |prefix|
    return GROUP_LABELS[prefix] if event_type.start_with?(prefix)
  end

  # Derive from base kind + prefix
  case base_kind
  when :state
    "Room State Events"
  when :call
    "VoIP Events"
  when :room
    "Room Message Events"
  when :basic
    # Distinguish ephemeral from account data:
    # Ephemeral events are delivered via /sync ephemeral section.
    # These are the well-known ones; anything else is account data.
    if %w[m.typing m.receipt m.presence].include?(event_type)
      "Ephemeral Events"
    elsif event_type.start_with?("m.room_key", "m.forwarded_room_key", "m.secret", "m.dummy", "m.key_backup")
      "E2E & Key Management Events"
    else
      "Account Data & Other Events"
    end
  end
end

def group_sort_key(label)
  idx = GROUP_ORDER.index(label)
  idx ? format("%02d", idx) : "99_#{label}"
end

# ── Extract content properties from a schema ────────────────────────

def resolve_ref(ref_path)
  candidates = [
    SCHEMA_DIR / ref_path,
    SHARED_DIR / ref_path.sub(%r{^\.\./}, ""),
  ]
  candidates.each { |p| return load_schema(p) if p.exist? }
  {}
end

def extract_content_props(schema)
  content = schema.dig("properties", "content") || {}

  # If content itself is a $ref, resolve it
  if content["$ref"]
    content = resolve_ref(content["$ref"])
  end

  # Merge in call_event mixin properties if present
  (content["allOf"] || []).each do |entry|
    if entry["$ref"]
      mixin = resolve_ref(entry["$ref"])
      mixin_props = mixin["properties"] || {}
      mixin_required = mixin["required"] || []
      content["properties"] = (content["properties"] || {}).merge(mixin_props)
      content["required"] = ((content["required"] || []) + mixin_required).uniq
    end
  end

  props = content["properties"] || {}
  required = content["required"] || []

  # Also handle patternProperties (e.g. m.direct has "^@" pattern)
  pattern_props = content["patternProperties"]
  content_description = content["description"]

  fields = {}
  props.each do |name, spec|
    next unless spec.is_a?(Hash)

    type_val = spec["type"]
    type_str = case type_val
               when Array then type_val.compact.join(" | ")
               when nil then "object"
               else type_val.to_s
               end

    desc = (spec["description"] || "").gsub(/\n\s+/, " ").strip

    # Append enum values to description if present
    if spec["enum"]
      desc += " One of: `#{spec["enum"].join("`, `")}`."
    end

    fields[name] = {
      description: desc,
      type: type_str,
      required: required.include?(name),
    }

    # If this is a nested object with its own properties, note the sub-fields
    if spec["properties"] && !spec["properties"].empty?
      sub_fields = spec["properties"].map { |k, v|
        sub_desc = (v["description"] || "").gsub(/\n\s+/, " ").strip
        "`#{k}` (#{v["type"] || "object"}): #{sub_desc}"
      }
      fields[name][:description] += " Contains: #{sub_fields.join("; ")}." unless sub_fields.empty?
    end
  end

  # Describe patternProperties if present
  if pattern_props && fields.empty? && content_description
    fields["(pattern keys)"] = {
      description: content_description.gsub(/\n\s+/, " ").strip,
      type: "object",
      required: false,
    }
  end

  [fields, required]
end

# ── Data structures ─────────────────────────────────────────────────

EventSchema = Struct.new(
  :file, :event_type, :variant, :title, :description,
  :base_kind, :group, :content_props, :required_fields,
  :example, :variants,
  keyword_init: true
) do
  def has_content_props?
    content_props && !content_props.empty?
  end
end

# ── Load all schemas ────────────────────────────────────────────────

all_schemas = []

Pathname.glob(SCHEMA_DIR / "m.*.yaml").each do |path|
  schema = load_schema(path)
  file_stem = path.basename(".yaml").to_s

  # Parse event_type and variant from filename
  parts = file_stem.split("$", 2)
  event_type = parts[0]
  variant = parts[1]

  # Get concrete type from schema enum if available
  type_enum = schema.dig("properties", "type", "enum")
  event_type = type_enum.first if type_enum&.any?

  refs = collect_refs(schema)
  base_kind = detect_base_kind(refs)
  group = derive_group(event_type, base_kind)

  content_props, required_fields = extract_content_props(schema)
  example = load_example(file_stem)

  all_schemas << EventSchema.new(
    file: file_stem,
    event_type: event_type,
    variant: variant,
    title: schema["title"],
    description: (schema["description"] || "").strip,
    base_kind: base_kind,
    group: group,
    content_props: content_props,
    required_fields: required_fields,
    example: example,
    variants: [],
  )
end

# ── Organize: attach variants to parent events, group by category ───

primary_events = all_schemas.reject(&:variant)
variant_events = all_schemas.select(&:variant)

# Attach variants to their parent
variant_events.each do |v|
  parent = primary_events.find { |p| p.event_type == v.event_type }
  parent.variants << v if parent
end

# Group primary events by their derived group label
groups = primary_events.group_by(&:group).map { |label, events|
  {
    label: label,
    events: events.sort_by(&:event_type),
  }
}.sort_by { |g| group_sort_key(g[:label]) }

# ── Render ERB ──────────────────────────────────────────────────────

def format_example_json(example)
  return nil unless example
  JSON.pretty_generate(example)
end

template_source = TEMPLATE.read
erb = ERB.new(template_source, trim_mode: "-")
result = erb.result(binding)

OUTPUT.write(result)
puts "Generated #{OUTPUT.relative_path_from(ROOT)} (#{result.lines.count} lines)"
