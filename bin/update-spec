#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the MIT License.
# Copyright, 2026, by Nathan K.

# Generates the specification manifests in lib/async/matrix/abstract, one beside each Ruby file, so that the two can be read side by side: the manifest has the same shape as the code it describes.
#
# @example
#   bin/update-spec              # every version in MATRIX_API_VERSIONS.txt
#   bin/update-spec v1.18 v1.19  # only rebuild these versions' deltas
#
# A manifest holds the whole surface at the newest version, which is what the class body implements, followed by one entry per specification version holding only what that version changed, which is what the version layer implements. An empty entry means the specification changed nothing, so an empty layer beside it is correct.
#
# Every operation in the client-server API appears in exactly one manifest. Those which no class implements yet get a manifest with no Ruby beside it, which is the map of what is left to build.
#
# The specifications come from the submodules in ./data, one per released version, so this needs no network. Run bin/fetch-spec first.

require "yaml"
require "uri"
require "json_schemer"

ROOT = File.expand_path("..", __dir__)
DATA = File.join(ROOT, "data")
OUTPUT = File.join(ROOT, "lib", "async", "matrix", "abstract", "api")

METHODS = %w[get put post delete patch].freeze

# The specification describes five APIs. Each is namespaced, both here and in lib, because they are separate protocols which happen to share a repository: a client implements client-server, a bridge implements application-service, and nothing should be able to confuse the two.
#
# The directory is named as the specification names it; the namespace is the Ruby spelling of it.
APIS = {
  "client-server" => "client_server",
  "server-server" => "server_server",
  "identity" => "identity",
  "application-service" => "application_service",
  "push-gateway" => "push_gateway",
}.freeze

# The specification files each existing manifest covers, so that a manifest sits beside the Ruby it describes. Anything not claimed here is generated into a manifest named after its specification file, which keeps coverage complete without inventing names for concepts we have not modelled.
GROUPS = {
  "client_server" => {
    "rooms" => %w[
      rooms.yaml room_send.yaml room_state.yaml create_room.yaml joining.yaml leaving.yaml
      message_pagination.yaml list_joined_rooms.yaml
     ],
    "sync" => %w[sync.yaml],
    "session" => %w[login.yaml logout.yaml whoami.yaml],
  },
}.freeze

def versions
  File.readlines(File.join(ROOT, "MATRIX_API_VERSIONS.txt"), chomp: true).reject(&:empty?)
end

def directory_for(version, api)
  File.join(DATA, "matrix-spec-#{version}", "data", "api", api)
end

# One line, so a manifest stays readable next to the code.
def sentence(text)
  if text
    line = text.to_s.split.join(" ")
    if line.include?(". ")
      line = line.split(". ").first + "."
    end
    line.length > 140 ? "#{line[0, 137]}..." : line
  else
    nil
  end
end

# Follow every $ref, which json_schemer resolves against the document's base URI - including the `#/components/...` pointers the specification uses for shared parameters.
def dereference(node, schema, base, seen = [], depth = 0)
  if depth > 24
    node
  else
    case node
    when Hash
      if reference = node["$ref"]
        uri = URI.join(base, reference)
        if seen.include?(uri.to_s)
          node.reject{|key, _| key == "$ref"}
        else
          begin
            target = schema.resolve_ref(uri)
          rescue => error
            warn "  could not resolve #{reference}: #{error.class}"
            node.reject{|key, _| key == "$ref"}
          else
            resolved = dereference(target.value, schema, uri, seen + [uri.to_s], depth + 1)
            rest = node.reject{|key, _| key == "$ref"}.transform_values do |value|
              dereference(value, schema, base, seen, depth + 1)
            end

            resolved.is_a?(Hash) ? resolved.merge(rest) : resolved
          end
        end
      else
        node.transform_values{|value| dereference(value, schema, base, seen, depth + 1)}
      end
    when Array
      node.map{|value| dereference(value, schema, base, seen, depth + 1)}
    else
      node
    end
  end
end

# A schema as a field tree: the names, types and requiredness needed to write the call.
def fields(schema, depth = 0)
  if schema.is_a?(Hash) && depth <= 14
    combined = %w[allOf oneOf anyOf].filter_map do |keyword|
      entries = schema[keyword]
      unless entries
        next
      end

      merged = {}
      entries.each do |entry|
        part = fields(entry, depth)
        if part.is_a?(Hash)
          merged.merge!(part)
        end
      end

      merged.empty? ? nil : merged
    end.first

    if combined
      combined
    elsif schema["type"] == "array"
      inner = fields(schema["items"], depth + 1)
      inner ? [inner] : "array"
    else
      properties = schema["properties"]
      patterns = schema["patternProperties"]

      # A map keyed by something the specification does not name - a room ID, a user ID. Up to v1.10 these were `additionalProperties`; from v1.11 they are `patternProperties` with a key pattern.
      # Both describe the same thing, and without handling both, everything inside them is lost.
      additional = schema["additionalProperties"]
      unless additional.is_a?(Hash)
        additional = nil
      end

      if properties || patterns || additional
        required = Array(schema["required"])
        out = {}

        properties&.each do |name, value|
          unless value.is_a?(Hash)
            next
          end

          entry = {"type" => value["type"] || "object"}
          if required.include?(name)
            entry["required"] = true
          end
          if value["description"]
            entry["description"] = sentence(value["description"])
          end
          if value["enum"]
            entry["enum"] = value["enum"]
          end

          nested = fields(value, depth + 1)
          if nested
            entry["fields"] = nested
          end

          out[name] = entry
        end

        # A keyed map is always `(*)`, whichever construct expressed it, with the key pattern kept as metadata. Otherwise the switch from `additionalProperties` to `patternProperties` at v1.11 reads as 127 fields removed and 131 added, when nothing about the API changed.
        patterns&.each do |pattern, value|
          unless value.is_a?(Hash)
            next
          end

          entry = {"type" => value["type"] || "object", "keyed_by" => pattern}
          nested = fields(value, depth + 1)
          if nested
            entry["fields"] = nested
          end

          out[patterns.size == 1 ? "(*)" : "(#{pattern})"] = entry
        end

        if additional
          entry = {"type" => additional["type"] || "object", "keyed_by" => "*"}
          nested = fields(additional, depth + 1)
          if nested
            entry["fields"] = nested
          end

          out["(*)"] = entry
        end

        out.empty? ? nil : out
      else
        nil
      end
    end
  else
    nil
  end
end

# Every operation in a version, keyed by operationId.
def operations(version, api)
  directory = directory_for(version, api)

  if File.directory?(directory)
    base = URI("file://#{directory}/")
    resolver = proc{|uri| YAML.safe_load_file(uri.path, aliases: true)}
    found = {}
    Dir.children(directory).grep(/\.yaml\z/).sort.each do |name|
      document = YAML.safe_load_file(File.join(directory, name), aliases: true)
      unless document.is_a?(Hash) && document["paths"]
        next
      end

      schema = JSONSchemer.schema(document, base_uri: base, ref_resolver: resolver)

      # The specification was Swagger 2.0 up to v1.7 and OpenAPI 3.1 from v1.8. The two describe the same API in different shapes, so both are normalised here - otherwise the delta at v1.8 reports every operation as rewritten, which says nothing about the API.
      if document["swagger"]
        prefix = document["basePath"].to_s
      else
        prefix = document.dig("servers", 0, "variables", "basePath", "default").to_s
      end

      document["paths"].each do |route, item|
        unless item.is_a?(Hash)
          next
        end

        item.each do |method, operation|
          unless METHODS.include?(method) && operation.is_a?(Hash)
            next
          end

          resolved = dereference(operation, schema, base)
          identifier = resolved["operationId"] || "#{method}:#{route}"

          entry = {
            "source" => name,
            "method" => method.upcase,
            "path" => prefix + route,
          }
          if resolved["summary"]
            entry["summary"] = sentence(resolved["summary"])
          end

          security = resolved["security"]
          entry["authentication"] = !(security.nil? || security == [{}])

          parameters = {}
          Array(resolved["parameters"]).each do |parameter|
            unless parameter.is_a?(Hash) && parameter["name"]
              next
            end

            place = parameter["in"] || "query"

            # Swagger 2.0 puts the body in a parameter; OpenAPI 3.1 has requestBody.
            if place == "body"
              request = fields(parameter["schema"])
              if request
                entry["request"] = request
              end
              next
            end

            shape = parameter["schema"] || parameter
            field = {"type" => shape["type"] || "string"}
            if parameter["required"]
              field["required"] = true
            end
            if parameter["description"]
              field["description"] = sentence(parameter["description"])
            end
            if shape["enum"]
              field["enum"] = shape["enum"]
            end

            nested = fields(shape, 1)
            if nested
              field["fields"] = nested
            end

            (parameters[place] ||= {})[parameter["name"]] = field
          end
          unless parameters.empty?
            entry["parameters"] = parameters
          end

          unless entry.key?("request")
            body = resolved.dig("requestBody", "content", "application/json", "schema")
            request = body && fields(body)
            if request
              entry["request"] = request
            end
          end

          responses = {}
          Hash(resolved["responses"]).each do |status, response|
            unless response.is_a?(Hash)
              next
            end

            schema_for = response["schema"] || response.dig("content", "application/json", "schema")
            responses[status.to_s] = (schema_for && fields(schema_for)) || sentence(response["description"])
          end
          unless responses.empty?
            entry["responses"] = responses
          end

          found[identifier] = entry
        end
      end
    end
    found
  else
    {}
  end
end

if ARGV.empty?
  selected = versions
else
  selected = ARGV
end

total = 0

selected.each do |version|
  warn version

  APIS.each do |api, namespace|
    catalogue = operations(version, api)
    if catalogue.empty?
      next
    end

    total += catalogue.size

    claimed = (GROUPS[namespace] || {}).each_with_object({}) do |(manifest, sources), out|
      sources.each{|source| out[source] = manifest}
    end

    manifests = {}
    catalogue.each do |identifier, entry|
      manifest = claimed[entry["source"]] || File.basename(entry["source"], ".yaml")
      (manifests[manifest] ||= {})[identifier] = entry
    end

    manifests.sort.each do |manifest, entries|
      # Every schema for an API sits in one directory, beside the Ruby which implements it.
      directory = File.join(OUTPUT, namespace, "schemas")

      require "fileutils"
      FileUtils.mkdir_p(directory)

      out = {
        "api" => api,
        "version" => version,
        "generated_from" => "data/matrix-spec-#{version}/data/api/#{api}",
        "sources" => entries.values.map{|entry| entry["source"]}.uniq.sort,
        "operations" => entries.sort.to_h,
      }

      File.write(
        File.join(directory, "#{manifest}-#{version}.yaml"),
        "# Generated by bin/update-spec from data/matrix-spec-#{version}. Do not edit.\n" + YAML.dump(out)
      )
    end

    warn format("  %-20s %3d operations across %2d manifests", namespace, catalogue.size, manifests.size)
  end
end

warn "\n#{total} operations written for #{selected.size} versions."
