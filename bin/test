#!/usr/bin/env bash

# TEST(1)                            General Commands Manual                          TEST(1)
#
# NAME
#      bin/test — run the suite against a Matrix specification version
#
# SYNOPSIS
#      bin/test [--all] [--api name] [--backend name] [--core] [--keep-alive] [version ...]
#
# DESCRIPTION
#      bin/test brings up a homeserver which implements the given specification version and
#      runs the suite against it. Each backend has a directory holding a compose file with a
#      service per version, carrying its own image and configuration, so testing a version is
#      naming it.
#
#      Only one homeserver runs at a time, since they all bind the same port: each version is
#      brought up in turn and taken down on the way out.
#
#      With no version, the latest one is tested. With no --api and no --core, the whole
#      suite is run.
#
#      The backends are different servers rather than different versions of one, so a run
#      says which it was: the point of having more than one is that the suite tests the
#      specification rather than whatever Synapse happens to do.
#
#      An API whose server is not a homeserver gets that server too: the identity API sydent,
#      the push gateway API sygnal, and the application service API the stub which answers in
#      a bridge's place. The client-server API also gets the OAuth 2.0 rig, which is a second
#      homeserver delegating authentication to an authorization server.
#
# OPTIONS
#      --all   Test every version in MATRIX_API_VERSIONS.txt, in order.
#
#      --api name
#              Run only that API's tests: its structural test, the tests of its classes, and
#              the version layers those are built from. The specification has five APIs and
#              this takes the specification's own name for them, so client-server rather than
#              client_server, which is how the workflows are named too. May be given more
#              than once.
#
#      --backend name
#              The homeserver to test against, which is a directory holding a compose file.
#              Defaults to synapse.
#
#      --core  Run only the tests which belong to no API: the wrappers, the versioning, the
#              events, the credentials, and everything else the APIs are built from.
#
#      --keep-alive
#              Leave the homeserver running afterwards, and reuse it when it is already the
#              version wanted. This is what you want while iterating: the suite then costs
#              seconds rather than a container start, and a run of sus(1) by hand afterwards
#              has something to talk to.
#
# ENVIRONMENT
#      MATRIX_VERSION
#              Set for the suite, to the version under test. The fixtures read it to build
#              the classes for that version.
#
#      MATRIX_BACKEND
#              Set for the suite, to the backend being tested.
#
#      MATRIX_ACCOUNTS
#              Set for the suite, to how it is to get an account: login where the backend
#              registers a user on first login, or register where the suite must register one
#              first. The backend decides this, not the suite.
#
#      IMAGE_OWNER
#              Read by the compose file, to name the registry the images come from.
#
#      SYNAPSE_PORT
#              Read by the compose file, to move the homeserver off port 7300. A second
#              version can be brought up alongside the first with it. SYDENT_PORT,
#              SYGNAL_PORT, APPSERVICE_PORT, MAS_PORT and OAUTH_SYNAPSE_PORT do the same for
#              the other servers, which the fixtures are told about by MATRIX_HOMESERVER,
#              MATRIX_IDENTITY_SERVER, MATRIX_PUSH_GATEWAY, MATRIX_APPLICATION_SERVICE and
#              MATRIX_OAUTH_HOMESERVER.
#
# FILES
#      MATRIX_API_VERSIONS.txt
#              The versions which can be tested, generated from the Synapse compose file by
#              the Update Matrix Versions List workflow. Adding a service to each backend is
#              all that is needed to add a version.
#
#      <backend>/docker-compose.yml
#              The homeservers of one backend, one service per version.
#
#      test/operations/<api>.rb
#              What one API owes against its own schemas, which is what --api runs first.
#
# EXIT STATUS
#      The bin/test utility exits 0 on success, and >0 if an error occurs.
#
# EXAMPLES
#      Test the latest version on Synapse:
#
#            bin/test
#
#      Test two versions:
#
#            bin/test v1.11 v1.12
#
#      Test one API, which is what CI does per workflow:
#
#            bin/test --api client-server
#
#      Iterate against a homeserver which stays up between runs:
#
#            bin/test --keep-alive --core
#
# SEE ALSO
#      sus(1), .github/workflows/test.yaml, .github/workflows/test-client-server.yaml
#
# async-matrix                          October 11, 2026                              TEST(1)

set -o errexit
set -o nounset

root="$(cd "$(dirname "$0")/.." && pwd)"

# The versions which can be tested, generated from the Synapse compose file by the Update Matrix
# Versions List workflow, which also checks that every backend offers the same ones. Adding a
# service to each backend is all that is needed to add a version.
mapfile -t versions < "$root/MATRIX_API_VERSIONS.txt"

all="no"
keep_alive="no"

# Which APIs to test, or none for the whole suite. The specification has five, each with its own
# schemas, classes and tests, and CI runs a workflow per API: see .github/workflows/test-<api>.yaml.
#
# Named as the specification names them - client-server, push-gateway - which is how the workflows
# are named too. Ruby spells the same names with underscores, since that is what a file is called,
# so the name is translated where it is used as a path.
apis=()

# Whether to run the tests which belong to no API: the wrappers, the versioning, the events, and
# everything else the APIs are built from.
core="no"
backend="${MATRIX_BACKEND:-synapse}"
chosen=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all)
      all="yes"
      ;;
    --keep-alive)
      keep_alive="yes"
      ;;
    --api)
      shift

      if [ "$#" -eq 0 ]; then
        echo "--api needs a name." >&2
        exit 1
      fi

      apis+=("$1")
      ;;
    --api=*)
      apis+=("${1#--api=}")
      ;;
    --core)
      core="yes"
      ;;
    --backend)
      shift

      if [ "$#" -eq 0 ]; then
        echo "--backend needs a name." >&2
        exit 1
      fi

      backend="$1"
      ;;
    --backend=*)
      backend="${1#--backend=}"
      ;;
    -*)
      echo "Unknown option $1." >&2
      exit 1
      ;;
    *)
      chosen+=("$1")
      ;;
  esac

  shift
done

compose="$root/$backend/docker-compose.yml"

if [ ! -f "$compose" ]; then
  echo "Unknown backend $backend: $compose does not exist." >&2
  exit 1
fi

# How the suite is to get an account, which the backend decides rather than the suite.
#
# The Synapse rig carries a module which registers a user on first login, so logging in is enough
# and registration stays closed. Tuwunel has no way to accept any password, so its rig opens
# registration instead and the suite registers the user before logging in. The suite reads this as
# MATRIX_ACCOUNTS; see fixtures/async/matrix/client_context.rb.
case "$backend" in
  synapse)
    accounts="login"
    ;;
  *)
    accounts="register"
    ;;
esac

# Reported on the way out either way, so that it is said even when the suite fails:
if [ "$keep_alive" = "yes" ]; then
  trap 'echo "The homeserver is still running. Stop it with:" >&2
    echo "  docker compose --file $backend/docker-compose.yml down" >&2' EXIT
else
  trap 'docker compose --file "$compose" down' EXIT
fi

# The version whose homeserver is running, if one is.
running() {
  docker compose --file "$compose" ps --services --filter status=running 2>/dev/null | head -1
}

# The servers each API is tested against, which are servers of their own rather than homeservers:
# the identity API is tested against sydent, the push gateway API against sygnal, and the
# application service API against the stub which answers in a bridge's place.
services=()

# Whether the OAuth 2.0 rig is wanted, which the client-server API needs for the authorization
# metadata operations. It is a homeserver of its own - one which delegates authentication to the
# authorization server instead of handling passwords - so it is a compose profile rather than
# another service beside the homeserver under test.
oauth="no"

add_service() {
  case "$1" in
    client-server|client_server) oauth="yes" ;;
    identity) services+=(sydent) ;;
    push-gateway|push_gateway) services+=(sygnal) ;;
    application-service|application_service) services+=(appservice) ;;
  esac
}

if [ "${#apis[@]}" -eq 0 ] && [ "$core" = "no" ]; then
  # The whole suite, which is every API.
  services=(sydent sygnal appservice)
  oauth="yes"
else
  for api in ${apis[@]+"${apis[@]}"}; do
    add_service "$api"
  done
fi

start() {
  local version="$1"

  if [ "$keep_alive" = "yes" ] && [ "$(running)" = "$version" ]; then
    echo "Reusing the $backend $version homeserver, which is already running." >&2
  else
    docker compose --file "$compose" down
    docker compose --file "$compose" up --detach --wait "$version"
  fi

  if [ "${#services[@]}" -gt 0 ]; then
    # The identity server joins the homeserver's network namespace, so it is told which homeserver
    # is running: `localhost` has to mean the homeserver for an OpenID token to be verified.
    MATRIX_SERVICE="$version" docker compose --file "$compose" up --detach --wait "${services[@]}"
  fi

  if [ "$oauth" = "yes" ]; then
    docker compose --file "$compose" --profile oauth up --detach --wait oauth-synapse

    # The user the suite consents as, seeded once the homeserver is up: registering a user
    # provisions it into the homeserver as well, and one seeded while the homeserver was down
    # exists at the authorization server alone, which leaves every exchange refused.
    #
    # It refuses to register a user it already has, which is what a rig kept alive looks like, so
    # that is not a failure here.
    docker compose --file "$compose" --profile oauth up --force-recreate --no-log-prefix oauth-mas-user || true
  fi
}

# The paths the chosen APIs' tests live at, which is empty when none was chosen.
#
# An API has a structural test, a test per class, and the version layers those tests are built from.
# A path which does not exist yet is left out, so an API whose tests are not written is just its
# structural test.
paths=()
selection=()

if [ "$core" = "yes" ]; then
  selection+=("the core")

  # Everything which is not an API: what is left once the APIs' own paths are taken out.
  while IFS= read -r candidate; do
    paths+=("$candidate")
  done < <(cd "$root" && find test -name "*.rb" \
    -not -path "test/operations/*" \
    -not -path "test/async/matrix/api/*" \
    -not -path "test/async/matrix/abstract/api/*" | sort)
fi

for api in ${apis[@]+"${apis[@]}"}; do
  selection+=("$api")

  # The specification's name as Ruby spells it: `client-server` is `client_server` on disk.
  directory="${api//-/_}"

  if [ ! -d "$root/lib/async/matrix/abstract/api/$directory/schemas" ]; then
    echo "Unknown api $api: lib/async/matrix/abstract/api/$directory/schemas does not exist." >&2
    exit 1
  fi

  for candidate in "test/operations/$directory.rb" "test/async/matrix/api/$directory" "test/async/matrix/abstract/api/$directory"; do
    if [ -e "$root/$candidate" ]; then
      paths+=("$candidate")
    fi
  done
done

run_tests() {
  local version="$1"

  if [[ ! " ${versions[*]} " == *" $version "* ]]; then
    echo "Unknown version $version, expected one of: ${versions[*]}" >&2
    return 1
  fi

  start "$version"

  if [ "${#selection[@]}" -gt 0 ]; then
    echo "Testing Matrix $version on $backend, for ${selection[*]}." >&2
  else
    echo "Testing Matrix $version on $backend." >&2
  fi

  MATRIX_VERSION="$version" MATRIX_BACKEND="$backend" MATRIX_ACCOUNTS="$accounts" bundle exec sus ${paths[@]+"${paths[@]}"}
}

if [ "$all" = "yes" ]; then
  chosen=("${versions[@]}")
elif [ "${#chosen[@]}" -eq 0 ]; then
  # No version asked for: the latest one.
  chosen=("${versions[-1]}")
fi

for version in "${chosen[@]}"; do
  run_tests "$version"
done
