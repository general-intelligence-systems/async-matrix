#!/usr/bin/env bash

# Run the test suite against a Matrix specification version, on a homeserver which implements it.
# Each backend has a directory with a compose file which has a service per version, carrying its
# own image and configuration.
#
#   bin/test                      # the latest version, on Synapse
#   bin/test --all                # every version
#   bin/test v1.11 v1.12          # just these
#   bin/test --backend tuwunel    # on tuwunel instead
#   bin/test --keep-alive         # and leave the homeserver running afterwards
#
# Only one homeserver runs at a time - they all bind the same port - so each version is brought up
# in turn and taken down at the end. `--keep-alive` leaves it running, and reuses it when it is
# already the version wanted, which is what you want while iterating: the suite then costs seconds
# rather than a container start, and a run of `sus` by hand afterwards has something to talk to.
#
# The backends are different servers, not different versions of one, so a run says which it was:
# the point of having more than one is that the suite is testing the specification rather than
# whatever Synapse happens to do.

set -o errexit
set -o nounset

root="$(cd "$(dirname "$0")/.." && pwd)"

# The versions which can be tested, generated from the Synapse compose file by the Update Matrix
# Versions List workflow, which also checks that every backend offers the same ones. Adding a
# service to each backend is all that is needed to add a version.
mapfile -t versions < "$root/MATRIX_API_VERSIONS.txt"

all="no"
keep_alive="no"
backend="${MATRIX_BACKEND:-synapse}"
chosen=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all)
      all="yes"
      ;;
    --keep-alive)
      keep_alive="yes"
      ;;
    --backend)
      shift

      if [ "$#" -eq 0 ]; then
        echo "--backend needs a name." >&2
        exit 1
      fi

      backend="$1"
      ;;
    --backend=*)
      backend="${1#--backend=}"
      ;;
    -*)
      echo "Unknown option $1." >&2
      exit 1
      ;;
    *)
      chosen+=("$1")
      ;;
  esac

  shift
done

compose="$root/$backend/docker-compose.yml"

if [ ! -f "$compose" ]; then
  echo "Unknown backend $backend: $compose does not exist." >&2
  exit 1
fi

# How the suite is to get an account, which the backend decides rather than the suite.
#
# The Synapse rig carries a module which registers a user on first login, so logging in is enough
# and registration stays closed. Tuwunel has no way to accept any password, so its rig opens
# registration instead and the suite registers the user before logging in. The suite reads this as
# MATRIX_ACCOUNTS; see fixtures/async/matrix/client_context.rb.
case "$backend" in
  synapse)
    accounts="login"
    ;;
  *)
    accounts="register"
    ;;
esac

# Reported on the way out either way, so that it is said even when the suite fails:
if [ "$keep_alive" = "yes" ]; then
  trap 'echo "The homeserver is still running. Stop it with:" >&2
    echo "  docker compose --file $backend/docker-compose.yml down" >&2' EXIT
else
  trap 'docker compose --file "$compose" down' EXIT
fi

# The version whose homeserver is running, if one is.
running() {
  docker compose --file "$compose" ps --services --filter status=running 2>/dev/null | head -1
}

start() {
  local version="$1"

  if [ "$keep_alive" = "yes" ] && [ "$(running)" = "$version" ]; then
    echo "Reusing the $backend $version homeserver, which is already running." >&2
  else
    docker compose --file "$compose" down
    docker compose --file "$compose" up --detach --wait "$version"
  fi
}

run_tests() {
  local version="$1"

  if [[ ! " ${versions[*]} " == *" $version "* ]]; then
    echo "Unknown version $version, expected one of: ${versions[*]}" >&2
    return 1
  fi

  start "$version"

  echo "Testing Matrix $version on $backend." >&2

  MATRIX_VERSION="$version" MATRIX_BACKEND="$backend" MATRIX_ACCOUNTS="$accounts" bundle exec sus
}

if [ "$all" = "yes" ]; then
  chosen=("${versions[@]}")
elif [ "${#chosen[@]}" -eq 0 ]; then
  # No version asked for: the latest one.
  chosen=("${versions[-1]}")
fi

for version in "${chosen[@]}"; do
  run_tests "$version"
done
