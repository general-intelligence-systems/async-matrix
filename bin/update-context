#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# UPDATE-CONTEXT(1)                 General Commands Manual                 UPDATE-CONTEXT(1)
#
# NAME
#      bin/update-context — generate the agent context this gem ships from the documentation
#
# SYNOPSIS
#      bin/update-context [--check]
#
# DESCRIPTION
#      Writes context/, which is what an AI agent working on a project which depends on this
#      gem reads.  It follows the agent context specification
#      (https://github.com/socketry/agent-context): a gem provides context as markdown files
#      in a context/ directory at its root, a consumer installs them into its own
#      .agents/context/<gem>/, and context/index.yaml is what names and orders them.
#
#      The pages under docs/content/docs are the source.  docs/content/docs/meta.json gives
#      the order, each page's front matter gives its title and description, and its body
#      becomes the markdown beside it: docs/content/docs/design.mdx becomes
#      context/design.md.  index.mdx becomes context/overview.md, because a page which is the
#      site's root reads as an overview once it is one file among others.
#
#      MDX is not markdown, so two things are rewritten.  A <Cards> block becomes a list of
#      links, and a link into /docs becomes a link to the file beside it, so that the bundle a
#      consumer installs stands on its own with no site to serve it.  Any other component is
#      an error rather than something to drop silently: convert it in the page, or teach this
#      script what it means.
#
#      With --check nothing is written and a difference is an error, which is what a hook or a
#      workflow runs.  Re-run the script without it to settle the difference.
#
#      The files this writes are generated, and are committed and shipped: context/ is in the
#      gemspec's files, so it reaches a consumer through the gem rather than through this
#      repository.  Edit the pages under docs/content/docs, never context/.
#
# FILES
#      docs/content/docs/meta.json
#              Which pages there are, and the order they are read in.
#
#      docs/content/docs/<page>.mdx
#              The source of each context file: front matter for the title and description,
#              body for the markdown.
#
#      context/<name>.md
#              What this writes, and what a consumer installs.
#
#      context/index.yaml
#              The description, the gemspec metadata, and every file with its title and
#              description.  This is what an agent reads first.
#
#      async-matrix.gemspec
#              Where the summary and the metadata in index.yaml come from.
#
# EXIT STATUS
#      The bin/update-context utility exits 0 on success, and >0 if an error occurs.  With
#      --check, a context file which does not match the documentation is an error, which is
#      what makes it usable from a hook or a workflow.
#
# EXAMPLES
#      Regenerate the context:
#
#            bin/update-context
#
#      Report whether what is committed matches the documentation:
#
#            bin/update-context --check
#
# SEE ALSO
#      bin/license(1), bin/rubocop(1)
#
# async-matrix                          October 12, 2026                   UPDATE-CONTEXT(1)

require "fileutils"
require "json"
require "yaml"
require "rubygems"

ROOT = File.expand_path("..", __dir__)
DOCS = File.join(ROOT, "docs", "content", "docs")
CONTEXT = File.join(ROOT, "context")
GEMSPEC = File.join(ROOT, "async-matrix.gemspec")

# A page which is the site's root reads as an overview once it is one file among others.
NAMES = {"index" => "overview"}.freeze

BANNER = "Generated by bin/update-context from docs/content/docs. Do not edit: edit the pages there and re-run it."

# Where a page ends up, by the name the site knows it as.
def name_for(page)
  NAMES.fetch(page, page)
end

# A link into the site, as a link to the file beside it.
def reference(href)
  if href.start_with?("/docs")
    page = href.delete_prefix("/docs").delete_prefix("/")

    "#{name_for(page.empty? ? 'index' : page)}.md"
  else
    href
  end
end

# The attributes of one JSX element, which are quoted strings here.
def attributes(source)
  source.scan(/(\w+)="([^"]*)"/).to_h
end

# A <Cards> block, as the list of links it is.
def links(block)
  block.scan(/<Card\b[^>]*?\/>/m).map do |card|
    attribute = attributes(card)
    description = attribute["description"]

    "- [#{attribute['title']}](#{reference(attribute['href'])})#{description ? " — #{description}" : ''}"
  end.join("\n")
end

# The front matter and the body of a page.
def parts(path)
  match = /\A---\n(?<front_matter>.*?)\n---\n(?<body>.*)\z/m.match(File.read(path))

  if match.nil?
    abort "#{path} has no front matter: a page needs its title and description."
  end

  [YAML.safe_load(match[:front_matter]), match[:body]]
end

# A page's body, as markdown which stands on its own.
def markdown(path, body)
  body = body.gsub(/^<Cards>\n(?<cards>.*?)^<\/Cards>\n/m){"#{links(Regexp.last_match[:cards])}\n"}
  body = body.gsub(/\]\((\/docs[^)]*)\)/){"](#{reference(Regexp.last_match(1))})"}

  remaining = body.scan(/^\s*<\/?[A-Z][\w.]*/).map(&:strip).uniq

  unless remaining.empty?
    abort "#{path} uses components this script does not understand: #{remaining.join(' ')}. " \
      "Convert them in the page, or teach bin/update-context what they mean."
  end

  body.sub(/\A\n+/, "").rstrip
end

# What one context file should contain.
def context_for(page)
  path = File.join(DOCS, "#{page}.mdx")

  unless File.exist?(path)
    abort "#{path} does not exist, but docs/content/docs/meta.json names it."
  end

  front_matter, body = parts(path)

  content = [
    "<!-- #{BANNER} -->",
    "",
    "# #{front_matter['title']}",
    "",
    markdown(path, body),
    "",
  ].join("\n")

  {
    "path" => "#{name_for(page)}.md",
    "title" => front_matter["title"],
    "description" => front_matter["description"],
    "content" => content,
  }
end

# The context files which no page accounts for, so that a renamed or removed page does not leave
# its own behind.
def stale(written)
  if Dir.exist?(CONTEXT)
    Dir.children(CONTEXT).reject{|child| written.include?(child)}
  else
    []
  end
end

# The index, which is what an agent reads first.
def index_for(files)
  specification = Gem::Specification.load(GEMSPEC)

  {
    "description" => specification.summary,
    "metadata" => specification.metadata,
    "files" => files.map{|file| file.reject{|key, _| key == "content"}},
  }
end

check = ARGV.delete("--check")

unless ARGV.empty?
  abort "Usage: bin/update-context [--check]"
end

pages = JSON.parse(File.read(File.join(DOCS, "meta.json")))["pages"]

files = pages.map{|page| context_for(page)}

# Every path this run accounts for, so that a page which was renamed or removed does not leave its
# context file behind.
written = files.map{|file| file["path"]} + ["index.yaml"]

contents = files.to_h{|file| [file["path"], file["content"]]}

contents["index.yaml"] = "# #{BANNER}\n" + YAML.dump(index_for(files))

differences = contents.reject do |path, content|
  full_path = File.join(CONTEXT, path)

  File.exist?(full_path) && File.read(full_path) == content
end

if check
  stale(written).each do |child|
    warn "  #{child} is not generated by anything: no page accounts for it."
  end

  differences.each_key do |path|
    warn "  #{path} does not match the documentation."
  end

  if differences.empty? && stale(written).empty?
    warn "context/ matches docs/content/docs: #{files.size} files."
  else
    abort "\ncontext/ is out of date. Run bin/update-context."
  end
else
  FileUtils.mkdir_p(CONTEXT)

  stale(written).each do |child|
    File.delete(File.join(CONTEXT, child))
    warn "  #{child} removed: no page accounts for it."
  end

  contents.each do |path, content|
    File.write(File.join(CONTEXT, path), content)
  end

  files.each do |file|
    warn format("  %-20s %s", file["path"], file["title"])
  end

  warn "\n#{files.size} files written to context/, #{differences.size} changed."
end
