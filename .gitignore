# Jekyll docs build artifacts
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
docs/vendor/

# Synapse runtime artifacts
**/files/homeserver.db
**/files/homeserver.db-shm
**/files/homeserver.db-wal
**/files/homeserver.pid
**/files/media_store/
**/files/*.signing.key

# Generated TLS certificates
**/certs/

# Schemas
/schemas/

# Gems
/.gem/

# Nix
/.direnv/
result

# Editor
*.swp
*.swo
*~
/refs
*.gem
sqlite
*.db

# Rust / native extension build artifacts (compiled at install time)
*.so
/tmp/
# Workspace build dir lives at the repo root now (see /Cargo.toml).
/target/
/ext/**/target/
# The resolved lockfile is committed at the workspace root (/Cargo.lock) for
# reproducible cross-compiled gems; only stray per-crate locks are ignored.
ext/**/Cargo.lock
/pkg/
.example-test-bundle
